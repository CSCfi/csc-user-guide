{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ProperDocs",
      "type": "debugpy",
      "request": "launch",
      "module": "properdocs",
      "args": [
        "serve"
      ],
      "env": {
        "PROPERDOCS_ENV": "preview"
