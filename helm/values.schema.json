{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "gitSource": {
      "description": "GitBuildSource for BuildConfigs.",
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "ref": {
          "type": "string"
        }
      },
      "required": [
        "uri"
      ]
    },
    "githubRepository": {
      "description": "GitHub repository.",
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "default": "github.com",
          "format": "hostname"
        },
        "org": {
          "type": "string",
          "default": "CSCfi"
        },
        "name": {
          "type": "string",
          "default": "csc-user-guide"
        }
      }
    },
    "githubBranch": {
      "description": "A branch in a GitHub repository.",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/githubRepository"
        }
      ],
      "properties": {
        "branch": {
          "type": "string",
          "default": "master"
        }
      }
    },
    "deploymentReplicas": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "enableLookupFlag": {
      "description": "Attempt to lookup existing resources on the cluster.",
      "type": [
        "boolean",
        "null"
      ],
      "default": false
    },
    "cronSuspend": {
      "type": "boolean",
      "default": false
    },
    "cronSchedule": {
      "description": "A cron expression.",
      "type": "string"
    },
    "imageName": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      },
      "required": [
        "image",
        "tag"
      ]
    },
    "matomoSiteId": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "lang": {
      "description": "A target language to translate the site to.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        },
        "name": {
          "description": "The name of the target language, e.g. 'Finnish'.",
          "type": "string",
          "minLength": 2
        },
        "matomoSiteId": {
          "$ref": "#/$defs/matomoSiteId"
        }
      },
      "required": [
        "code",
        "name"
      ]
    },
    "configBranch": {
      "type": [
        "string",
        "null"
      ]
    },
    "osConfig": {
      "type": "object",
      "properties": {
        "authUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "secretsFile": {
          "type": [
            "string",
            "null"
          ]
        },
        "useResourceLookup": {
          "$ref": "#/$defs/enableLookupFlag"
        }
      },
      "if": {
        "properties": {
          "useResourceLookup": {
            "const": false
          }
        },
        "required": [
          "useResourceLookup"
        ]
      },
      "then": {
        "required": [
          "secretsFile",
          "authUrl"
        ],
        "properties": {
          "secretsFile": {
            "type": "string"
          },
          "authUrl": {
            "type": "string"
          }
        }
      }
    },
    "resticConfig": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "host": {
          "type": "string"
        }
      },
      "required": [
        "repository",
        "host"
      ]
    },
    "cacheConfig": {
      "type": "object",
      "properties": {
        "container": {
          "type": "string"
        },
        "prefix": {
          "type": "string"
        }
      },
      "required": [
        "container",
        "prefix"
      ]
    },
    "siteConfig": {
      "type": "object",
      "properties": {
        "host": {
          "type": [
            "string",
            "null"
          ],
          "format": "hostname"
        },
        "matomoUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "useAllowlistLookup": {
          "$ref": "#/$defs/enableLookupFlag"
        },
        "ipAllowlist": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "acme": {
          "type": "object",
          "properties": {
            "useResourceLookup": {
              "$ref": "#/$defs/enableLookupFlag"
            },
            "issuerName": {
              "type": [
                "string",
                "null"
              ]
            },
            "secretsFile": {
              "description": "YAML file with ACME EAB details.",
              "type": [
                "string",
                "null"
              ]
            },
            "if": {
              "properties": {
                "useResourceLookup": {
                  "const": false
                }
              },
              "required": [
                "useResourceLookup"
              ]
            },
            "then": {
              "required": [
                "secretsFile",
                "issuerName"
              ],
              "properties": {
                "acmeFile": {
                  "type": "string"
                },
                "issuerName": {
                  "type": "string"
                }
              }
            },
            "else": {
              "required": [
                "issuerName"
              ]
            }
          }
        }
      }
    },
    "originalConfig": {
      "type": "object",
      "properties": {
        "repo": {
          "$ref": "#/$defs/githubBranch"
        },
        "matomoSiteId": {
          "$ref": "#/$defs/matomoSiteId"
        },
        "replicaCount": {
          "$ref": "#/$defs/deploymentReplicas"
        }
      }
    },
    "translatorConfig": {
      "type": "object",
      "properties": {
        "repo": {
          "$ref": "#/$defs/githubBranch"
        },
        "configBranchOverride": {
          "$ref": "#/$defs/configBranch"
        },
        "useResourceLookup": {
          "$ref": "#/$defs/enableLookupFlag"
        },
        "secretsFile": {
          "type": [
            "string",
            "null"
          ]
        },
        "languages": {
          "description": "Configuration for all of the languages the site is to be translated to from English.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/lang"
          },
          "minItems": 1
        },
        "restoreOnly": {
          "type": "boolean",
          "default": false
        },
        "suspend": {
          "$ref": "#/$defs/cronSuspend"
        },
        "schedule": {
          "$ref": "#/$defs/cronSchedule",
          "default": "0 0 * * 1-5"
        },
        "restic": {
          "$ref": "#/$defs/resticConfig"
        },
        "cache": {
          "$ref": "#/$defs/cacheConfig"
        },
        "storageCapacity": {
          "type": [
            "string",
            "null"
          ],
          "default": "2Gi"
        },
        "if": {
          "properties": {
            "useResourceLookup": {
              "const": false
            }
          },
          "required": [
            "useResourceLookup"
          ]
        },
        "then": {
          "required": [
            "secretsFile",
            "languages",
            "restic",
            "cache"
          ],
          "properties": {
            "secretsFile": {
              "type": "string"
            }
          }
        },
        "else": {
          "required": [
            "languages",
            "restic",
            "cache"
          ]
        }
      }
    },
    "alternateConfig": {
      "type": "object",
      "properties": {
        "repo": {
          "$ref": "#/$defs/githubBranch"
        },
        "configBranchOverride": {
          "$ref": "#/$defs/configBranch"
        },
        "replicaCount": {
          "$ref": "#/$defs/deploymentReplicas"
        }
      }
    },
      },
      "configBranchOverride": {
        "$ref": "#/$defs/configBranch"
      }
    }
  },
  "properties": {
    "git": {
      "$ref": "#/$defs/gitSource"
    },
    "environment": {
      "type": [
        "string",
        "null"
      ],
      "default": "preview"
    },
    "nameOverride": {
      "type": [
        "string",
        "null"
      ]
    },
    "builder": {
      "$ref": "#/$defs/imageName"
    },
    "server": {
      "$ref": "#/$defs/imageName"
    },
    "restic": {
      "$ref": "#/$defs/imageName"
    },
    "localRegistry": {
      "type": "string"
    },
    "os": {
      "$ref": "#/$defs/osConfig"
    },
    "timeZone": {
      "type": [
        "string",
        "null"
      ]
    },
    "site": {
      "$ref": "#/$defs/siteConfig"
    },
    "components": {
      "type": "object",
      "properties": {
        "original": {
          "$ref": "#/$defs/originalConfig"
        },
        "translator": {
          "$ref": "#/$defs/translatorConfig"
        },
        "alternate": {
          "$ref": "#/$defs/alternateConfig"
        }
      },
      "required": [
        "original",
        "translator"
      ]
    }
  },
  "required": [
    "git",
    "builder",
    "server",
    "restic",
    "localRegistry",
    "os",
    "site",
    "components"
  ]
}